rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName','email','createdAt','updatedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt']);
      allow delete: if false;

      match /deletionRequests/{requestId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['requestType','status','requestedAt'])
          && request.resource.data.requestType == 'account-deletion'
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time;
        allow update, delete: if false;
      }

      match /legalConsents/{consentId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['termsVersion','privacyVersion','acceptedAt','method'])
          && request.resource.data.termsVersion is string
          && request.resource.data.privacyVersion is string
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.method in ['email','google'];
        allow update, delete: if false;
      }

      match /progress/{progressId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['completedQuestionIds','correctQuestionIds','updatedAt'])
          && request.resource.data.completedQuestionIds is list
          && request.resource.data.completedQuestionIds.size() <= 10000
          && request.resource.data.correctQuestionIds is list
          && request.resource.data.correctQuestionIds.size() <= 10000;
        allow delete: if isOwner(uid);
      }

      match /examHistory/{historyId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['mode','questionCount','answeredCount','correctCount','incorrectCount','unansweredCount','earnedPoints','possiblePoints','scorePercent','durationSeconds','questionResults','completedAt'])
          && request.resource.data.mode == 'self-study'
          && request.resource.data.questionCount is int
          && request.resource.data.questionCount > 0
          && request.resource.data.questionCount <= 600
          && request.resource.data.answeredCount is int
          && request.resource.data.correctCount is int
          && request.resource.data.incorrectCount is int
          && request.resource.data.unansweredCount is int
          && request.resource.data.earnedPoints is number
          && request.resource.data.possiblePoints is int
          && request.resource.data.scorePercent is int
          && request.resource.data.scorePercent >= 0
          && request.resource.data.scorePercent <= 100
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds >= 0
          && request.resource.data.questionResults is list
          && request.resource.data.questionResults.size() == request.resource.data.questionCount
          && request.resource.data.completedAt is timestamp;
        allow update, delete: if false;
      }

      match /savedQuestions/{savedId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && savedId == 'default'
          && request.resource.data.keys().hasOnly(['questionIds','updatedAt'])
          && request.resource.data.questionIds is list
          && request.resource.data.questionIds.size() <= 6000;
        allow delete: if isOwner(uid);
      }

      match /settings/{settingsId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && settingsId == 'preferences'
          && request.resource.data.keys().hasOnly(['dailyGoal','defaultExamLength','showRationales','compactLayout','largerText','studyReminders','updatedAt'])
          && request.resource.data.dailyGoal in [10, 20, 30, 50, 75]
          && request.resource.data.defaultExamLength in [20, 60, 85, 150, 600]
          && request.resource.data.showRationales is bool
          && request.resource.data.compactLayout is bool
          && request.resource.data.largerText is bool
          && request.resource.data.studyReminders is bool;
        allow delete: if false;
      }
    }

    match /questionFeedback/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['questionId','itemType','topic','prompt','feedback','mode','reporterEmail','createdAt','status'])
        && request.resource.data.questionId is string
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() > 0
        && request.resource.data.feedback.size() <= 5000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      allow read: if signedIn();
      allow update: if isWebmaster()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNotes','updatedAt'])
        && request.resource.data.status in ['new','under-review','resolved','rejected']
        && request.resource.data.adminNotes is string
        && request.resource.data.adminNotes.size() <= 5000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function isWebmaster() { return signedIn() && request.auth.token.admin == true; }

    match /questionDrafts/{draftId} {
      allow read, create, update, delete: if isWebmaster();
    }

    match /webmasterAuditLog/{entryId} {
      allow read: if isWebmaster();
      allow create: if isWebmaster();
      allow update, delete: if false;
    }

    match /questions/{questionId} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow create, update: if isWebmaster();
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}